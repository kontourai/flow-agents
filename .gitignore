dist/
build/
_site/
test-results/

# Local Flow Agents state. Non-durable workflow/session artifacts live under
# .kontourai/flow-agents. Durable source belongs in docs/, context/,
# integrations/, scripts/, or tracked bundle source directories.
.flow-agents/*
!.flow-agents/
!.flow-agents/config/
!.flow-agents/config/**
.claude/
/.codex/
.ai/
.omx/
.telemetry/
.promptfoo/
.veritas/claims/
.veritas/evidence/
.veritas/eval-drafts/
.veritas/init-plans/
.veritas/runs/
.veritas/standards-feedback-drafts/
.surface/
.kontourai/

# Dependency installs and build caches
node_modules/
node_modules
.venv/
__pycache__/
*.py[cod]

# Generated eval output
evals/results/*.json
evals/results/reports/

# OS/editor noise
.DS_Store
*.log
.kontour/

# Local Flow CLI install for source-tree validation (CI recreates it)
.flow-cli/

# Demo recordings are regenerable test outputs (vhs tape / asciinema + prove-teeth) — don't commit the binaries.
# A finalized README/docs gif is committed deliberately under docs/assets/, not the raw evals/acceptance/ output.
evals/acceptance/*.mp4
evals/acceptance/*.gif

# delivery/<slug>/ holds a session's terminal delivery companions (trust.bundle +
# trust.checkpoint*). `flow-agents workflow publish-delivery` writes them locally, so the
# directory is ignored by default to keep stray local runs out of `git add -A`;
# merge-change requires the delivering session's own companions to be committed, so the
# delivery step force-adds exactly that session's directory.
delivery/*
