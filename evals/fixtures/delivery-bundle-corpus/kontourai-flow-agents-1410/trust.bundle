        "findings": [
          {
            "id": "f1-status-marker-collision",
            "severity": "medium",
            "status": "open",
            "description": "Installer deletes an unrelated PreToolUse handler if it shares this repository statusMessage, without checking command identity. Require marker plus generated command identity and test same-label preservation.",
            "file_refs": [
              "src/cli/codex-governance-hook.ts"
            ]
          }
        ],
        "lanes": [
          {
            "id": "correctness",
            "status": "fail",
            "summary": "A same-label unrelated PreToolUse handler is removed during installation; this violates AC1.",
            "evidence_refs": [
              {
                "kind": "source",
                "file": "src/cli/codex-governance-hook.ts",
                "line_start": 144,
                "line_end": 145,
                "excerpt": "const remaining = record.hooks.filter((handler) => handler.statusMessage !== status"
              }
            ]
          },
          {
            "id": "security",
            "status": "pass",
            "summary": "Reviewed command quoting, Git common-directory guard, package entrypoint resolution, output protocol validation, and target file replacement; no additional blocking issue found.",
            "evidence_refs": [
              {
                "kind": "artifact",
                "file": ".kontourai/flow-agents/kontourai-flow-agents-1410/codex-governance-review-569b913a.md",
                "summary": "Security review scope and remaining host limits."
              }
            ]
          },
          {
            "id": "portability",
            "status": "not_verified",
            "summary": "Windows command form is only exercised by a Unix shell in the focused test; Windows-host behavior remains unverified.",
            "evidence_refs": [
              {
                "kind": "source",
                "file": "src/cli/codex-governance-hook.test.mjs",
                "line_start": 89,
                "line_end": 101,
                "excerpt": "const windowsForm = spawnSync(\"sh\", [\"-c\", groups[1].hooks[0].commandWindows], {"
              }
            ]
          }
        ],
        "review_target": {
          "artifacts": [
            {
              "file": ".kontourai/flow-agents/kontourai-flow-agents-1410/codex-governance-review-569b913a.md",
              "sha256": "3aef0c603b606dbc19f765b9ec5598f26e6a8decc0a23c26c788736628f15aee"
            },
