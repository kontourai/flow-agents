{
  "apiVersion": "flowagents.kontourai.io/v1alpha1",
  "kind": "KitObservabilityContribution",
  "metadata": { "name": "future-observe" },
  "spec": {
    "contract_version": "2.0",
    "package_ref": "npm:@partner/future-observe@2.0.0",
    "projections": { "run_summary": { "schema_ref": "https://partner.example/schemas/future-run-summary/2.0.json" } },
    "authority_refs": { "flow": "flowagents.kontourai.io/v1alpha1/WorkflowRun" },
    "host": { "required_capabilities": ["standard_views"], "optional_capabilities": ["mcp_apps_resource_bridge"], "presentation": { "preferred": { "kind": "mcp_apps_resource_bridge", "resource": { "uri": "ui://partner.example/kits/future-observe/observability", "mime_type": "text/html;profile=mcp-app" }, "bridge": { "tool_name": "future-observe-observability", "visibility": ["model", "app"] } }, "fallback": { "kind": "standard_views", "source": "declared_projections" } } },
    "data_policy": { "redaction": "declared", "retention": "kit_owned", "raw_source": "unavailable" },
    "operator_intents": [],
    "compatibility": { "unsupported_version": "diagnostic" }
  }
}
