{
  "apiVersion": "flowagents.kontourai.io/v1alpha1",
  "kind": "KitObservabilityContribution",
  "metadata": { "name": "future-observe" },
  "spec": {
    "contract_version": "2.0",
    "kit": { "id": "future-observe" },
    "projections": [
      { "kind": "run_summary", "schema_ref": "https://partner.example/schemas/future-run-summary/2.0.json" }
    ],
    "views": ["run_summary"],
    "authority_refs": [
      { "authority": "flow", "ref": "flowagents.kontourai.io/v1alpha1/WorkflowRun" }
    ],
    "capabilities": { "local_export": "read", "sink": "unsupported" },
    "data_policy": { "redaction": "declared", "retention": "kit_owned", "raw_source": "unavailable" },
    "operator_actions": [],
    "compatibility": { "unsupported_version": "diagnostic" }
  }
}
