        "default": "requirements-analysis"
      },
      "route_back_policy": {
        "max_attempts": 2,
        "on_exceeded": "block"
      }
    },
    "code-generation-gate": {
      "step": "code-generation",
      "expects": [
        {
          "id": "code-generation-completion",
          "kind": "trust.bundle",
          "required": true,
          "description": "Code Generation: current required artifacts and applicable checks were observed.",
          "bundle_claim": {
            "claimType": "aidlc.code-generation-completion",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
