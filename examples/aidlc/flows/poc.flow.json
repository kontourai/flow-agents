            "claimType": "aidlc.state-init-completion",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ],
      "on_route_back": {
        "missing_evidence": "state-init",
        "default": "state-init"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      }
    },
    "intent-capture-gate": {
      "step": "intent-capture",
      "expects": [
        {
          "id": "intent-capture-completion",
          "kind": "trust.bundle",
          "required": true,
          "description": "Intent Capture & Framing: current required artifacts and applicable checks were observed.",
          "bundle_claim": {
            "claimType": "aidlc.intent-capture-completion",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        },
        {
          "id": "intent-capture-review",
          "kind": "trust.bundle",
          "required": true,
          "description": "Intent Capture & Framing: recorded review of the current artifact and source basis.",
          "bundle_claim": {
            "claimType": "aidlc.intent-capture-review",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ],
      "on_route_back": {
        "missing_evidence": "intent-capture",
        "default": "intent-capture"
      },
      "route_back_policy": {
        "max_attempts": 2,
        "on_exceeded": "block"
      }
    },
    "reverse-engineering-gate": {
      "step": "reverse-engineering",
      "expects": [
        {
