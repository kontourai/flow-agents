          "id": "requirements-analysis-review",
          "kind": "trust.bundle",
          "required": true,
          "description": "Requirements Analysis: recorded review of the current artifact and source basis.",
          "bundle_claim": {
            "claimType": "aidlc.requirements-analysis-review",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
