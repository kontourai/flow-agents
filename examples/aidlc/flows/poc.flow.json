        },
        {
          "id": "code-generation-review",
          "kind": "trust.bundle",
          "required": true,
          "description": "Code Generation: recorded review of the current artifact and source basis.",
          "bundle_claim": {
            "claimType": "aidlc.code-generation-review",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ],
      "on_route_back": {
        "missing_evidence": "code-generation",
        "default": "code-generation"
      },
      "route_back_policy": {
        "max_attempts": 2,
        "on_exceeded": "block"
      }
    },
    "build-and-test-gate": {
      "step": "build-and-test",
      "expects": [
        {
          "id": "build-and-test-completion",
          "kind": "trust.bundle",
          "required": true,
          "description": "Build and Test: current required artifacts and applicable checks were observed.",
          "bundle_claim": {
