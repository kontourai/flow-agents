      ],
      "on_route_back": {
        "missing_evidence": "reverse-engineering",
        "default": "reverse-engineering"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      }
    },
    "requirements-analysis-gate": {
      "step": "requirements-analysis",
      "expects": [
        {
          "id": "requirements-analysis-completion",
          "kind": "trust.bundle",
          "required": true,
          "description": "Requirements Analysis: current required artifacts and applicable checks were observed.",
          "bundle_claim": {
