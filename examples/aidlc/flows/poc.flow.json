{
  "id": "aidlc.poc",
  "version": "1.0",
  "steps": [
    {
      "id": "workspace-scaffold",
      "next": "workspace-detection",
      "needs": []
    },
    {
      "id": "workspace-detection",
      "next": "state-init",
      "needs": [
        "workspace-scaffold"
      ]
    },
    {
      "id": "state-init",
      "next": "intent-capture",
      "needs": [
        "workspace-detection"
      ]
    },
    {
      "id": "intent-capture",
      "next": "reverse-engineering",
      "needs": []
    },
    {
      "id": "reverse-engineering",
      "next": "requirements-analysis",
      "needs": [
        "state-init"
      ]
    },
    {
      "id": "requirements-analysis",
      "next": "code-generation",
      "needs": [
        "reverse-engineering"
      ]
    },
    {
      "id": "code-generation",
      "next": "build-and-test",
      "needs": []
    },
    {
      "id": "build-and-test",
      "next": null,
      "needs": [
        "code-generation"
      ]
    }
  ],
  "gates": {
    "workspace-scaffold-gate": {
      "step": "workspace-scaffold",
      "expects": [
        {
          "id": "workspace-scaffold-completion",
          "kind": "trust.bundle",
          "required": true,
          "description": "Workspace Scaffold: current required artifacts and applicable checks were observed.",
          "bundle_claim": {
            "claimType": "aidlc.workspace-scaffold-completion",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ],
      "on_route_back": {
        "missing_evidence": "workspace-scaffold",
        "default": "workspace-scaffold"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      }
    },
    "workspace-detection-gate": {
      "step": "workspace-detection",
      "expects": [
        {
          "id": "workspace-detection-completion",
          "kind": "trust.bundle",
          "required": true,
          "description": "Workspace Detection: current required artifacts and applicable checks were observed.",
          "bundle_claim": {
            "claimType": "aidlc.workspace-detection-completion",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ],
      "on_route_back": {
        "missing_evidence": "workspace-detection",
        "default": "workspace-detection"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      }
    },
    "state-init-gate": {
      "step": "state-init",
      "expects": [
        {
          "id": "state-init-completion",
          "kind": "trust.bundle",
