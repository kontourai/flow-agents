{
  "id": "builder.build-lean",
  "version": "1.4",
  "description": "REDUCED-GATE ABLATION VARIANT of builder.build. Same steps, same sequencing, same terminal behaviour — but design-probe-gate and plan-gate are REMOVED, so the design-probe and plan steps survive only as unenforced sequencing passthroughs: they demand no skill, produce no artifact, and gate no evidence. This flow enforces STRICTLY FEWER gates than builder.build and must never be read as, substituted for, or reported as the full flow. It exists as the independent variable of the gate-value ablation: builder.build is the control, this is the treatment, and the run record's flow_id/definition_version/definition_digest is what tells the two apart after the fact.",
  "phase_map": {
    "pickup": "pull-work",
    "planning": "plan",
    "execution": "execute",
    "verification": "verify",
    "goal_fit": "merge-ready",
    "evidence": "merge-ready",
    "release": "pr-open",
    "learning": "learn"
  },
  "steps": [
    { "id": "pull-work", "next": "design-probe" },
    { "id": "design-probe", "next": "plan" },
    { "id": "plan", "next": "execute" },
    { "id": "execute", "next": "verify" },
    { "id": "verify", "next": "merge-ready" },
    { "id": "merge-ready", "next": "pr-open" },
    { "id": "pr-open", "next": "merge-ready-ci", "uses_flow": "builder.publish-learn" },
    { "id": "merge-ready-ci", "next": "learn", "uses_flow": "builder.publish-learn" },
    { "id": "learn", "next": "done", "uses_flow": "builder.publish-learn" },
    { "id": "done", "next": null }
  ],
  "gates": {
    "pull-work-gate": {
      "step": "pull-work",
      "expects": [
        {
          "id": "selected-work",
          "kind": "trust.bundle",
          "required": true,
          "description": "A ready work item is selected with scope and acceptance context.",
          "bundle_claim": {
            "claimType": "builder.pull-work.selected",
            "subjectType": "work-item",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ]
    },
    "execute-gate": {
      "step": "execute",
      "on_route_back": {
        "plan_gap": "plan"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      },
      "expects": [
        {
          "id": "implementation-scope",
          "kind": "trust.bundle",
          "required": true,
          "description": "The implementation scope records changed files and excludes unrelated work.",
          "bundle_claim": {
            "claimType": "builder.execute.scope",
            "subjectType": "change",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ]
    },
    "verify-gate": {
      "step": "verify",
      "on_route_back": {
        "missing_evidence": "verify",
        "implementation_defect": "execute",
        "plan_gap": "plan",
        "decision_gap": "design-probe",
        "default": "verify"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      },
      "expects": [
        {
          "id": "clean-critique",
          "kind": "trust.bundle",
          "required": true,
          "description": "A distinct reviewer recorded a current clean critique of the delivered change.",
          "bundle_claim": {
            "claimType": "workflow.critique.review",
            "subjectType": "workflow-critique",
            "accepted_statuses": ["verified"]
          }
        },
        {
          "id": "acceptance-criteria",
          "kind": "trust.bundle",
          "required": true,
          "description": "The selected Work Item acceptance criteria have verified evidence.",
          "bundle_claim": {
            "claimType": "workflow.acceptance.criterion",
            "subjectType": "flow-step",
            "accepted_statuses": ["verified"]
          }
        },
        {
          "id": "tests-evidence",
          "kind": "trust.bundle",
          "required": true,
          "description": "Relevant tests or checks have evidence tied to the implemented change.",
          "bundle_claim": {
            "claimType": "builder.verify.tests",
            "subjectType": "flow-step",
            "accepted_statuses": [
              "verified"
            ]
          }
        },
        {
          "id": "policy-compliance",
          "kind": "trust.bundle",
          "required": false,
          "description": "Policy compliance evidence is attached when policy gates apply.",
          "explore_hint": "Use as advisory evidence for scope, security, privacy, release, or repository policy checks.",
          "bundle_claim": {
            "claimType": "builder.verify.policy-compliance",
            "subjectType": "artifact",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ]
    },
    "merge-ready-gate": {
      "step": "merge-ready",
      "on_route_back": {
        "missing_evidence": "verify",
        "implementation_defect": "execute",
        "plan_gap": "plan",
        "decision_gap": "design-probe",
        "default": "verify"
      },
      "route_back_policy": {
        "max_attempts": 3,
        "on_exceeded": "block"
      },
      "expects": [
        {
          "id": "merge-readiness",
          "kind": "trust.bundle",
          "required": true,
          "description": "The change is ready for merge review based on scope, evidence, and unresolved risks.",
          "bundle_claim": {
            "claimType": "builder.merge-ready.readiness",
            "subjectType": "change",
            "accepted_statuses": [
              "verified"
            ]
          }
        }
      ]
    }
  }
}
