  "scripts": {
    "knowledge:yaml:generate": "node scripts/build-knowledge-yaml.mjs",
    "knowledge:yaml:check": "node scripts/build-knowledge-yaml.mjs --check",
    "build": "npm run knowledge:yaml:check && tsc -p tsconfig.json && node build/src/cli.js capability-matrix --json-only && node build/src/tools/generate-install-identity.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build --silent && node build/src/cli.js build-bundles && node scripts/build-test-support.mjs && node --import ./src/cli/unit-test-state.mjs --test --test-concurrency=4 src/cli/*.test.mjs",
    "validate:source": "npm run build --silent && node build/src/cli.js validate-source",
    "validate:artifacts": "npm run build --silent && node build/src/cli/validate-workflow-artifacts.js",
    "context-map": "npm run build --silent && node build/src/cli.js context-map",
    "context-map:check": "npm run build --silent && node build/src/cli.js context-map --check",
    "capability-matrix": "npm run build --silent && node build/src/cli.js capability-matrix",
    "capability-matrix:check": "npm run build --silent && node build/src/cli.js capability-matrix --check",
    "host-conformance": "npm run build --silent && node build/src/tools/generate-host-conformance.js",
    "host-conformance:check": "npm run build --silent && node build/src/tools/generate-host-conformance.js --check",
    "build:bundles": "npm run build --silent && node build/src/cli.js build-bundles",
    "validate:package": "npm run build --silent && node build/src/cli.js validate-package",
    "workflow:sidecar": "npm run build --silent && node build/src/cli/workflow-sidecar.js",
    "workflow:validate-artifacts": "npm run build --silent && node build/src/cli/validate-workflow-artifacts.js",
    "effective-backlog-settings": "npm run build --silent && node build/src/cli.js effective-backlog-settings",
    "assignment-provider": "npm run build --silent && node build/src/cli.js assignment-provider",
    "effective-assignment-provider-settings": "npm run build --silent && node build/src/cli.js effective-assignment-provider-settings",
    "effective-change-provider-settings": "npm run build --silent && node build/src/cli.js effective-change-provider-settings",
    "effective-flow-agents-config": "npm run build --silent && node build/src/cli.js effective-flow-agents-config",
    "provider-bootstrap": "npm run build --silent && node build/src/cli.js provider-bootstrap",
    "pull-work-provider": "npm run build --silent && node build/src/cli.js pull-work-provider",
    "publish-change": "npm run build --silent && node build/src/cli.js publish-change",
    "merge-change": "npm run build --silent && node build/src/cli.js merge-change",
    "promote-workflow-artifact": "npm run build --silent && node build/src/cli.js promote-workflow-artifact",
    "usage-feedback": "npm run build --silent && node build/src/cli.js usage-feedback",
    "runtime-adapter": "npm run build --silent && node build/src/cli.js runtime-adapter",
    "telemetry-doctor": "npm run build --silent && node build/src/cli.js telemetry-doctor",
    "validate:hook-influence": "npm run build --silent && node build/src/cli.js validate-hook-influence",
    "workflow-artifact-cleanup-audit": "npm run build --silent && node build/src/cli.js workflow-artifact-cleanup-audit",
    "fixture:retirement-audit": "npm run build --silent && node build/src/cli.js fixture-retirement-audit",
    "dogfood": "npm run build --silent && node scripts/dogfood.js",
    "setup:repo-hooks": "bash scripts/setup-repo-hooks.sh",
    "validate:repo-hooks": "bash evals/static/test_repo_hooks.sh",
    "eval": "bash evals/run.sh",
    "eval:static": "bash evals/run.sh static",
    "eval:integration": "bash evals/run.sh integration",
    "eval:lifecycle-container": "bash evals/integration/test_lifecycle_authority_container.sh",
    "trust-reconcile-manifest": "bash evals/ci/run-baseline.sh --manifest-json",
    "eval:acceptance": "bash evals/run.sh acceptance",
    "eval:llm": "bash evals/run.sh llm",
    "eval:llm:codex": "bash evals/run.sh llm dev --runtime codex",
    "eval:llm:claude": "bash evals/run.sh llm dev --runtime claude --judge-runtime codex",
    "promptfoo": "PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_WAL_MODE=true PROMPTFOO_DISABLE_TELEMETRY=true promptfoo",
    "promptfoo:view": "PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_WAL_MODE=true PROMPTFOO_DISABLE_TELEMETRY=true promptfoo view",
    "check:content-boundary": "node scripts/check-content-boundary.cjs",
    "check:layer-boundary": "node scripts/check-layer-boundary.mjs",
    "check:hachure-boundary": "node scripts/check-hachure-boundary.mjs",
    "check:decisions": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/08c62ccd72880ff4bd4c378ae252ad437b4b4fb5 -- corpus decisions check --base ${DECISIONS_BASE:-origin/main}",
    "gen:decisions-index": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/08c62ccd72880ff4bd4c378ae252ad437b4b4fb5 -- corpus decisions index",
    "prepack": "npm run build:bundles --silent && node build/src/tools/bundle-pack-cli.js pack && npm run validate:source --",
    "kit": "npm run build --silent && node build/src/cli.js kit",
    "narrative-sources": "npm run build --silent && node build/src/cli.js narrative-sources",
    "reference:reviewed-grounding": "node evals/reference/reviewed-grounding-workflow/run.mjs",
    "docs:check": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/b127e35a818b532369843731b3c64792baade83e -- corpus check",
    "docs:build": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/b127e35a818b532369843731b3c64792baade83e -- corpus build",
    "test:delegation-rounds": "npm run build --silent && node --test src/cli/delegation-group-rounds.test.mjs src/cli/delegation-flow-runtime.test.mjs"
  },
