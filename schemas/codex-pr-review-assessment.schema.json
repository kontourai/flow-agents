{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-agents.dev/schemas/codex-pr-review-assessment.schema.json",
  "title": "Codex pull request review assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "coverage", "findings", "gaps"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "comment", "fail", "not_verified"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "status", "summary"],
        "properties": {
          "lane": {
            "type": "string",
            "enum": ["code", "security", "dependency", "architecture"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not_verified"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "requires_change", "file", "line", "title", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "requires_change": {
            "type": "boolean"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
