{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-agents.dev/schemas/codex-pr-review-assessment.schema.json",
  "title": "Codex pull request review assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "coverage", "findings", "gaps"],
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "pass" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "coverage": { "items": { "properties": { "status": { "const": "pass" } } } },
          "findings": { "maxItems": 0 },
          "gaps": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "comment" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "coverage": { "items": { "properties": { "status": { "const": "pass" } } } },
          "findings": { "items": { "properties": { "requires_change": { "const": false } } } },
          "gaps": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "fail" } }, "required": ["verdict"] },
      "then": {
        "anyOf": [
          { "properties": { "coverage": { "contains": { "properties": { "status": { "const": "fail" } }, "required": ["status"] } } } },
          { "properties": { "findings": { "contains": { "properties": { "requires_change": { "const": true } }, "required": ["requires_change"] } } } }
        ]
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "not_verified" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "coverage": { "items": { "properties": { "status": { "enum": ["pass", "not_verified"] } } } },
          "findings": { "items": { "properties": { "requires_change": { "const": false } } } }
        },
        "anyOf": [
          { "properties": { "coverage": { "contains": { "properties": { "status": { "const": "not_verified" } }, "required": ["status"] } } } },
          { "properties": { "gaps": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "comment", "fail", "not_verified"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "status", "summary"],
        "properties": {
          "lane": {
            "type": "string",
            "enum": ["code", "security", "dependency", "architecture"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not_verified"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "requires_change", "file", "line", "title", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "requires_change": {
            "type": "boolean"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "allOf": [
          {
            "if": { "properties": { "severity": { "enum": ["critical", "high"] } }, "required": ["severity"] },
            "then": { "properties": { "requires_change": { "const": true } } }
          },
          {
            "if": { "properties": { "severity": { "enum": ["low", "info"] } }, "required": ["severity"] },
            "then": { "properties": { "requires_change": { "const": false } } }
          }
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
