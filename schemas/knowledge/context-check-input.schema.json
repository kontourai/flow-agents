{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontourai.dev/schemas/knowledge/context-check-input/1.0.json",
  "title": "Knowledge Kit Context Check input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "repository", "revision", "target_audience", "knowledge_roots"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workspace": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "target_audience": { "type": "string", "minLength": 1 },
    "changed_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "knowledge_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "manifest_path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "const": "git-repo" },
          "manifest_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "anyOf": [
    { "required": ["changed_surfaces"] },
    { "required": ["diff"] }
  ]
}
