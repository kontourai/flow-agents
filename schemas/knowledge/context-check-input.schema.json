{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontourai.dev/schemas/knowledge/context-check-input/1.0.json",
  "title": "Knowledge Kit Context Check input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "repository", "revision", "target_audience", "knowledge_roots"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workspace": { "$ref": "#/$defs/identity" },
    "repository": { "$ref": "#/$defs/identity" },
    "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "target_audience": { "$ref": "#/$defs/identity" },
    "changed_surfaces": { "$ref": "#/$defs/surfaces" },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": { "paths": { "$ref": "#/$defs/surfaces" } }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claimId" }
    },
    "knowledge_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "manifest_path"],
        "properties": {
          "id": { "$ref": "#/$defs/claimId" },
          "provider": { "const": "git-repo" },
          "manifest_path": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "anyOf": [
    { "required": ["changed_surfaces"] },
    { "required": ["diff"] }
  ],
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
    "claimId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!\\s)(?!.*\\s$)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[\\u0000-\\u001F\\u007F]).+$" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    }
  }
}
