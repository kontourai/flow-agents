{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontourai.dev/schemas/flow-agents/run-correlation-envelope/1.0.json",
  "title": "Run correlation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "identities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "correlation_id": { "$ref": "#/$defs/opaqueIdentifier" },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_session",
        "runtime_turn",
        "flow_run",
        "flow_step",
        "work_item",
        "agent",
        "delegation_trace",
        "delegation_span",
        "terminal_record"
      ],
      "properties": {
        "runtime_session": { "$ref": "#/$defs/identity" },
        "runtime_turn": { "$ref": "#/$defs/identity" },
        "flow_run": { "$ref": "#/$defs/identity" },
        "flow_step": { "$ref": "#/$defs/identity" },
        "work_item": { "$ref": "#/$defs/workItemIdentity" },
        "agent": { "$ref": "#/$defs/identity" },
        "delegation_trace": { "$ref": "#/$defs/identity" },
        "delegation_span": { "$ref": "#/$defs/identity" },
        "terminal_record": { "$ref": "#/$defs/identity" }
      }
    }
  },
  "$defs": {
    "credentialFreeText": {
      "allOf": [
        { "type": "string" },
        { "not": { "anyOf": [
          { "pattern": "[A-Za-z][A-Za-z0-9+.-]*://[^\\s/?#@]*@" },
          { "pattern": "[Bb][Ee][Aa][Rr][Ee][Rr]\\s+" },
          { "pattern": "(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Ll][Ii][Ee][Nn][Tt][_-]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd])\\s*[:=]" },
          { "pattern": "(?:[Ss][Kk]|[Gg][Hh][OoPpRrSsUu]|[Nn][Pp][Mm]|[Pp][Yy][Pp][Ii]|[Hh][Ff])_[A-Za-z0-9_-]{8,}" },
          { "pattern": "[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_[A-Za-z0-9_]{12,}" },
          { "pattern": "[Xx][Oo][Xx][BbAaPpRrSs]-[A-Za-z0-9-]{8,}" },
          { "pattern": "[Gg][Ll][Pp][Aa][Tt]-[A-Za-z0-9_-]{8,}" },
          { "pattern": "AKIA[A-Z0-9]{12,}" },
          { "pattern": "AIza[A-Za-z0-9_-]{20,}" },
          { "pattern": "[Yy][Aa]29\\.[A-Za-z0-9_-]{8,}" },
          { "pattern": "SG\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}" },
          { "pattern": "(?:[Ww][Hh][Ss][Ee][Cc]|[SsRrPp][Kk]_(?:[Ll][Ii][Vv][Ee]|[Tt][Ee][Ss][Tt]))_[A-Za-z0-9_-]{8,}" },
          { "pattern": "(?:^|[^A-Za-z0-9])[Ss][Kk]-(?:[Pp][Rr][Oo][Jj]-|[Aa][Nn][Tt]-)?[A-Za-z0-9_-]{8,}" },
          { "pattern": "[Ss][Qq]0(?:[Aa][Tt][Pp]|[Cc][Ss][Pp])-[A-Za-z0-9_-]{8,}" },
          { "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\." }
        ] } }
      ]
    },
    "opaqueIdentifier": {
      "allOf": [
        { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,254}$" },
        { "$ref": "#/$defs/credentialFreeText" }
      ]
    },
    "workItemIdentifier": {
      "allOf": [
        { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:@#-]{0,254}|(?:[A-Za-z0-9][A-Za-z0-9._@-]*:)?[A-Za-z0-9._@-]+(?:/[A-Za-z0-9._@-]+)+(?:#[A-Za-z0-9._@-]+)?)$" },
        { "$ref": "#/$defs/credentialFreeText" }
      ]
    },
    "reason": {
      "allOf": [
        { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        { "$ref": "#/$defs/credentialFreeText" }
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "present" },
            "value": { "$ref": "#/$defs/opaqueIdentifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "enum": ["unavailable", "unsupported", "not_applicable"]
            },
            "reason": { "$ref": "#/$defs/reason" }
          }
        }
      ]
    },
    "workItemIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "present" },
            "value": { "$ref": "#/$defs/workItemIdentifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "enum": ["unavailable", "unsupported", "not_applicable"]
            },
            "reason": { "$ref": "#/$defs/reason" }
          }
        }
      ]
    }
  }
}
