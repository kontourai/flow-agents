{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-agents.dev/schemas/workflow-state.schema.json",
  "title": "Flow Agents Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_slug",
    "status",
    "phase",
    "updated_at",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_slug": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["new", "planning", "planned", "in_progress", "blocked", "verifying", "verified", "needs_decision", "not_verified", "failed", "delivered", "canceled", "accepted", "archived"]
    },
    "phase": {
      "type": "string",
      "enum": ["idea", "backlog", "pickup", "planning", "execution", "verification", "goal_fit", "evidence", "release", "learning", "done"]
    },
    "owner": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Routing branch for this session, e.g. agent/<actor>/<slug> (ADR 0021 \u00a73/\u00a75, issue #289). Optional for migration honesty: legacy/in-flight sessions predate this field. ensure-session always writes it for newly created sessions; validate-workflow-artifacts warns (does not fail) when it is absent."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_request": {
      "type": "string"
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "work_item_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Provider-neutral work item references anchoring this workflow session."
    },
    "run_correlation": {
      "oneOf": [
        {
          "$ref": "https://kontourai.dev/schemas/flow-agents/run-correlation-envelope/1.0.json"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "incomplete" },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      ]
    },
    "workflow_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "flow_status",
        "process_status",
        "verification_status",
        "quality_status"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "source": { "const": "canonical_flow_projection" },
        "flow_status": { "type": "string", "minLength": 1, "maxLength": 255 },
        "process_status": {
          "enum": ["completed", "blocked", "canceled", "failed", "not_verified"]
        },
        "verification_status": {
          "enum": ["PASS", "FAIL", "NOT_VERIFIED"]
        },
        "quality_status": { "const": "not_independently_evaluated" }
      }
    },
    "flow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "definition_id", "definition_version", "status", "current_step", "run_ref", "open_gate_ids"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "definition_id": { "type": "string", "minLength": 1 },
        "definition_version": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "run_head": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "type": "string", "minLength": 1 },
        "current_step": { "type": "string", "minLength": 1 },
        "run_ref": { "type": "string", "minLength": 1 },
        "open_gate_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "route_back_attempt": { "type": "integer", "minimum": 1 },
        "route_back_max_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["continue", "needs_user", "blocked", "done"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "target_phase": {
          "type": "string",
          "enum": ["idea", "backlog", "pickup", "planning", "execution", "verification", "goal_fit", "evidence", "release", "learning", "done"]
        },
        "target_artifact": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "command": {
          "description": "Compatibility alias of sync_command; observes canonical state and does not execute producer skills or submit evidence.",
          "type": "string",
          "minLength": 1
        },
        "command_role": {
          "const": "synchronization"
        },
        "sync_command": {
          "description": "Version-pinned public status command derived from the canonical gate-action envelope.",
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "description": "The agent owns orchestration; starting a run does not establish an external worker.",
          "const": "agent"
        },
        "execution_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executor", "skills", "operations", "artifact_targets", "sequence"],
          "properties": {
            "executor": { "const": "agent" },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "package", "path", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "package": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "version"],
                    "properties": {
                      "name": { "const": "@kontourai/flow-agents" },
                      "version": { "type": "string", "minLength": 1 }
                    }
                  },
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            },
            "operations": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "artifact_targets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "ref", "direct_write_allowed"],
                "properties": {
                  "kind": { "enum": ["file", "trust_slice"] },
                  "ref": { "type": "string", "minLength": 1 },
                  "direct_write_allowed": { "type": "boolean" }
                }
              }
            },
            "sequence": {
              "description": "Ordered producer, recording and synchronization sequence projected from the canonical stop condition.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidence_submission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutations", "schemas", "unresolved_expectation_ids", "adapter_evidence_is_gate_evidence"],
          "properties": {
            "schemas": {
              "description": "Schema definitions referenced by the canonical public mutation parameter metadata.",
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_ref_json"],
              "properties": {
                "evidence_ref_json": { "type": "object" }
              }
            },
            "mutations": {
              "description": "Canonical public mutation bindings, including their parameters and operation authority.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["expectation_id", "interface"],
                "properties": {
                  "expectation_id": { "type": "string", "minLength": 1 },
                  "interface": { "enum": ["workflow.evidence", "workflow.critique", "operation"] }
                }
              }
            },
            "unresolved_expectation_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "adapter_evidence_is_gate_evidence": { "const": false }
          }
        },
        "enforcement": {
          "description": "Deprecated compatibility field. Runtime steering ignores this value; session orchestration owns Builder Flow startup.",
          "type": "string",
          "enum": [
            "advisory",
            "before_tool_use"
          ]
        }
      }
    }
  }
}
