{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kontourai.dev/schemas/kontour.learning-review-proposals/0.2.json",
  "title": "kontour.learning-review-proposals",
  "description": "Per-run kit/gate tuning proposal document + ledger-line shape (flow-agents #352). Advisory only, never auto-applied. evidence.cost and evidence.defect are co-required on every proposal (R7-style Goodhart guard, mirrors kontour.console.economics's cost+defects co-requirement). v0.2 (additive) adds the correction-recurrence source family (flow-agents learn): target kinds agents-md/skill/hook/veritas-check, Thread message citations, an enforcement recommendation, and a model-judged conflict field.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "version", "window", "outcome", "aggregates", "proposals"],
  "allOf": [
    {
      "description": "A v0.1 document is exactly what v0.1 allowed: no source family, no v0.2 outcome, and only v0.1 patterns.",
      "if": { "properties": { "version": { "const": "0.1" } }, "required": ["version"] },
      "then": {
        "not": { "required": ["source_family"] },
        "properties": {
          "outcome": { "enum": ["ok", "insufficient-data"] },
          "proposals": { "items": { "properties": { "pattern": { "enum": ["kit-review-cost-inflation", "gate-false-block-review", "gate-well-calibrated"] } } } }
        }
      }
    }
  ],
  "properties": {
    "schema": { "const": "kontour.learning-review-proposals" },
    "version": { "type": "string", "enum": ["0.1", "0.2"] },
    "source_family": { "type": "string" },
    "window": {
      "type": "object",
      "additionalProperties": true,
      "required": ["since", "until"],
      "properties": {
        "since": { "type": ["number", "string", "null"] },
        "until": { "type": ["number", "string", "null"] }
      }
    },
    "records_considered": { "type": "number" },
    "outcome": {
      "type": "string",
      "enum": ["ok", "insufficient-data", "origin-unavailable"]
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": true,
      "required": ["by_kit", "by_gate", "partial"],
      "properties": {
        "by_kit": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["kit_id", "runs"],
            "properties": {
              "kit_id": { "type": "string" },
              "runs": { "type": "number" },
              "priced_runs": { "type": "integer", "minimum": 0 },
              "unpriced_runs": { "type": "integer", "minimum": 0 },
              "first_half_priced_runs": { "type": "integer", "minimum": 0 },
              "second_half_priced_runs": { "type": "integer", "minimum": 0 },
              "first_half_avg_cost_usd": { "type": ["number", "null"] },
              "second_half_avg_cost_usd": { "type": ["number", "null"] },
              "cost_trend_pct": { "type": ["number", "null"] },
              "first_half_findings_total": { "type": ["number", "null"] },
              "second_half_findings_total": { "type": ["number", "null"] },
              "findings_delta_pct": { "type": ["number", "null"] },
              "avg_wall_clock_s": { "type": ["number", "null"] },
              "avg_human_wait_s": { "type": ["number", "null"] },
              "route_back_rate": { "type": ["number", "null"] },
              "caught_false_completions_total": { "type": ["number", "null"] }
            }
          }
        },
        "by_gate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["gate_id", "fire_count"],
            "properties": {
              "gate_id": { "type": "string" },
              "fire_count": { "type": "number" },
              "correct_count": { "type": "number" },
              "false_block_count": { "type": "number" },
              "missed_block_count": { "type": "number" },
              "false_block_rate": { "type": ["number", "null"] },
              "avg_wall_clock_s_when_fired": { "type": ["number", "null"] },
              "avg_human_wait_s_when_fired": { "type": ["number", "null"] }
            }
          }
        },
        "by_theme": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["theme_id", "label", "occurrences", "sessions"],
            "properties": {
              "theme_id": { "type": "string" },
              "label": { "type": "string" },
              "state": { "enum": ["propose", "open", "hold"] },
              "occurrences": { "type": "integer", "minimum": 1 },
              "sessions": { "type": "integer", "minimum": 1 },
              "high_pain": { "type": "integer", "minimum": 0 },
              "qualifies": { "type": "boolean" }
            }
          }
        },
        "partial": { "type": "boolean" }
      }
    },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "proposal_id",
        "target",
        "pattern",
        "proposed_change",
        "evidence",
        "expected_effect",
        "decision"
      ],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "enum": ["kit", "gate", "agents-md", "skill", "hook", "veritas-check"] },
            "id": { "type": "string" }
          }
        },
        "pattern": {
          "type": "string",
          "enum": ["kit-review-cost-inflation", "gate-false-block-review", "gate-well-calibrated", "correction-recurrence"]
        },
        "proposed_change": { "type": "string", "minLength": 1 },
        "severity": { "const": "advisory" },
        "evidence": {
          "type": "object",
          "additionalProperties": true,
          "required": ["cost", "defect"],
          "description": "Goodhart guard (structural): cost and defect are co-required — no proposal may cite a cost/time signal without also pairing a defect signal, mirroring kontour.console.economics's own cost+defects co-requirement (R7).",
          "properties": {
            "cost": { "type": "object", "additionalProperties": true },
            "defect": { "type": "object", "additionalProperties": true }
          }
        },
        "expected_effect": {
          "type": "object",
          "additionalProperties": true,
          "required": ["metric", "direction", "description"],
          "properties": {
            "metric": { "type": "string", "minLength": 1 },
            "direction": { "type": "string", "enum": ["decrease", "increase", "maintain"] },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "decided_by", "decided_at", "rationale"],
          "properties": {
            "status": { "type": "string", "enum": ["proposed", "ratified", "rejected", "deferred"] },
            "decided_by": { "type": ["string", "null"] },
            "decided_at": { "type": ["string", "null"] },
            "rationale": { "type": ["string", "null"] }
          }
        },
        "follow_on_ref": { "type": ["string", "null"] },
        "effect_observed": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "required": ["measured_at", "metric", "before", "after", "moved"],
          "properties": {
            "measured_at": { "type": "string" },
            "metric": { "type": "string" },
            "before": { "type": ["number", "null"] },
            "after": { "type": ["number", "null"] },
            "moved": { "type": "string", "enum": ["improved", "worsened", "unchanged", "insufficient-data"] }
          }
        },
        "already_proposed": { "type": "boolean" }
      },
      "allOf": [
        { "$ref": "#/$defs/correctionRecurrence" },
        {
          "if": { "properties": { "pattern": { "const": "kit-review-cost-inflation" } }, "required": ["pattern"] },
          "then": { "properties": { "target": { "properties": { "kind": { "const": "kit" } } } } }
        },
        {
          "if": { "properties": { "pattern": { "enum": ["gate-false-block-review", "gate-well-calibrated"] } }, "required": ["pattern"] },
          "then": { "properties": { "target": { "properties": { "kind": { "const": "gate" } } } } }
        }
      ]
    },
    "ruleLine": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file", "line", "text"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "line": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string" },
        "judge": { "type": "string" }
      }
    },
    "correctionRecurrence": {
      "description": "v0.2: a correction-recurrence proposal (flow-agents learn) cites Thread messages (never raw transcripts), recommends an enforcement rung, and records whether a model judge found a conflicting or covering line in the target rule file.",
      "if": { "properties": { "pattern": { "const": "correction-recurrence" } }, "required": ["pattern"] },
      "then": {
        "required": ["source", "scope", "theme", "rule", "severity", "enforcement", "conflict", "conflict_check"],
        "properties": {
          "severity": { "const": "advisory" },
          "source": {
            "type": "object",
            "required": ["family", "producer"],
            "properties": {
              "family": { "const": "correction-recurrence" },
              "producer": { "type": "string" },
              "contract_version": { "const": "0.2" }
            }
          },
          "scope": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "enum": ["repo", "all-projects"] }, "repo": { "type": "string" } },
            "if": { "properties": { "kind": { "const": "repo" } } },
            "then": { "required": ["repo"] }
          },
          "target": { "properties": { "kind": { "enum": ["agents-md", "skill", "hook", "veritas-check"] } } },
          "theme": {
            "type": "object",
            "required": ["id", "label"],
            "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } }
          },
          "rule": { "type": "string", "minLength": 1 },
          "evidence": {
            "properties": {
              "cost": { "required": ["occurrences", "sessions", "high_pain", "rate_per_week"] },
              "defect": {
                "required": ["rule", "citations"],
                "properties": {
                  "citations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": ["thread_id", "message_id", "at", "excerpt"],
                      "properties": {
                        "thread_id": { "type": "string", "minLength": 1 },
                        "message_id": { "type": "string", "minLength": 1 },
                        "at": { "type": "string" },
                        "excerpt": { "type": "string", "maxLength": 200 },
                        "kind": { "enum": ["correction", "nudge", "frustration"] },
                        "pain": { "type": "integer", "minimum": 0, "maximum": 3 }
                      }
                    }
                  }
                }
              }
            }
          },
          "enforcement": {
            "type": "object",
            "required": ["recommended", "rung", "ladder", "reason"],
            "properties": {
              "recommended": { "enum": ["agents-md", "skill", "hook", "veritas-check"] },
              "rung": { "type": "integer", "minimum": 0, "maximum": 3 },
              "ladder": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string", "minLength": 1 },
              "prior_proposal_ids": { "type": "array", "items": { "type": "string" } }
            }
          },
          "conflict": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ruleLine" }] },
          "covered_by": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ruleLine" }] },
          "conflict_check": {
            "type": "object",
            "required": ["status", "file"],
            "properties": { "status": { "enum": ["checked", "skipped"] }, "file": { "type": ["string", "null"] } }
          },
          "expected_effect": { "properties": { "metric": { "const": "recurrence_per_week" }, "direction": { "const": "decrease" } } }
        }
      }
    }
  }
}
